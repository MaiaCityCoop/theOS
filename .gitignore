# media named by its BLAKE3 hash (Stories/scenes.js): kept beside the stories, not in git; objects.json says what each is
Stories/objects/
# the gate's stills, heat maps and reports (TheGame/tools/gate.js): made again by every run, not kept in git
.gate/

# the artifact library: the authors' own work stays on this machine (Artifacts/store.js)
Artifacts/items/*/source.md
Artifacts/items/*/thumb.jpg
