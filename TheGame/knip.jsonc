// knip, the dead-code gate of tools/health.js. It finds the pages vite builds (vite.config.js) and all they import by
// itself; besides them, what runs on its own: the tools, each a command, and the gate's two that run alone. jscpd is
// run by its path, never imported.
{
  "entry": ["tools/*.js", "tools/gate/cut.js", "tools/gate/pop.js"],
  "ignoreDependencies": ["jscpd"]
}
