# The game over HTTPS. setup-host.sh writes this file to /etc/caddy/Caddyfile with @SITE_HOST@ replaced.
# Caddy obtains and renews the certificate once the host's DNS record points here, and redirects HTTP to HTTPS.
# The release being served is the directory /srv/maia-city/current links to (deploy.sh switches it).

(game) {
	root * /srv/maia-city/current
	# /callback is callback.html; anything else that is not a file is a 404, never the game page.
	try_files {path} {path}.html
	file_server
}

@SITE_HOST@ {
	import game
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The OS dashboard may frame the game from this origin; nothing else may.
		Content-Security-Policy "frame-ancestors 'self'"
		-Server
	}
	# Vite names these by content hash, so they never change.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
}

# Only for deploy.sh's check on this machine: the same files, plain HTTP, never reachable from outside.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	import game
}
