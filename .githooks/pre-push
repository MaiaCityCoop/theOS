#!/bin/sh
# Before every push: the game builds, as CI checks it (.github/workflows/ci.yml), so it is never pushed red. Turned on
# once per clone: git config core.hooksPath .githooks. Skipped when nothing under TheGame/ is being pushed. (Since
# 2026-11-19 the game is 6ea75d6e's again: intent 0038's lint and smoke are on archive/0038-2026-11-19.)
PATH="$HOME/.bun/bin:$PATH"
root=$(git rev-parse --show-toplevel) || exit 1
changed=0
while read -r _local sha _remote base; do
  [ "$sha" = 0000000000000000000000000000000000000000 ] && continue
  [ "$base" = 0000000000000000000000000000000000000000 ] && base=$(git merge-base "$sha" origin/main 2>/dev/null)
  git diff --quiet "$base" "$sha" -- TheGame/ 2>/dev/null || changed=1
done
[ $changed = 0 ] && exit 0
cd "$root/TheGame" || exit 1
[ -d node_modules ] || { echo "pre-push: no node_modules here; run \`bun install\` in TheGame first (the hook never installs)"; exit 1; }
echo "pre-push: the game builds (vite build)…"
log=$(mktemp) && nice -n 15 bun run build >"$log" 2>&1 || { tail -20 "$log"; rm -f "$log"; echo "pre-push: the game does not build"; exit 1; }
rm -f "$log"
